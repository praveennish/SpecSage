# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
#
#   cp .env.local.example .env.local
#   set -a && source .env.local && set +a
#
# This file holds NO secrets. AWS credentials live in ~/.aws/credentials under the
# [specsage] profile; service credentials live in AWS Secrets Manager. If you find
# yourself wanting to put a key here, that's the signal to use Secrets Manager instead.

# Your 12-digit AWS account ID. Every AWS-touching Make target asserts against this
# before running, so a stray `default` profile cannot apply into the wrong account.
# RUNBOOK §1.1 and §2.3.
SPECSAGE_ACCOUNT_ID=123456789012

# Must be the named profile, never `default` — `default` is the corporate SSO profile.
AWS_PROFILE=specsage

AWS_REGION=us-east-1

# Set by the deploy workflow. Only needed locally when running smoke tests by hand.
# SPECSAGE_URL=https://xxxxxxxxxx.cloudfront.net
